---
import Icon from './Icon.astro';

interface Props {
	target: string;
	label: string;
}

const { target, label } = Astro.props;
---

<button
	type="button"
	class="zn-icon-btn"
	data-copy-target={target}
	aria-label={label}
	title={label}
>
	<Icon name="content_copy" size={18} class="zn-icon-copy" />
	<Icon name="check" size={18} class="zn-icon-check" />
</button>
