---
import { Code } from '@astrojs/starlight/components';
import type { Diagnostic } from '../data/diagnostics';
import { renderInlineMarkdown } from '../lib/markdown';
import Icon from './Icon.astro';

interface Props {
  diagnostic: Diagnostic;
}

const { diagnostic } = Astro.props;
const anchor = diagnostic.code.replaceAll('::', '-');
const message = renderInlineMarkdown(diagnostic.message);
const help = diagnostic.help ? renderInlineMarkdown(diagnostic.help) : null;
const severity = diagnostic.severity === 'warning' ? 'Warning' : 'Error';
---

<section class:list={['diag', diagnostic.severity]}>
  <h4 id={anchor} class="diag__head">
    <span class="diag__severity">{severity}</span>
    <a class="diag__code" href={`#${anchor}`}><code>{diagnostic.code}</code></a>
  </h4>

  <p class="diag__message" set:html={message} />

  {diagnostic.example && (
    <div class="diag__example">
      <Code code={diagnostic.example} lang="zn" />
    </div>
  )}

  {help && (
    <p class="diag__help">
      <Icon name="lightbulb" size={16} class="diag__help-icon" />
      <span set:html={help} />
    </p>
  )}
</section>

<style>
  .diag {
    margin-block: 16px;
    padding: 16px 20px 18px;
    border: 1px solid var(--zn-hairline);
    border-radius: 14px;
    background-color: var(--zn-surface);
  }

  .diag__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 10px;
    margin: 0;
    min-width: 0;
  }

  .diag__severity {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    flex: none;
    height: 22px;
    padding: 0 9px;
    border-radius: 999px;
    font-family: var(--sl-font);
    font-size: 12px;
    line-height: 1;
    font-weight: 500;
    color: var(--sl-color-red);
    background-color: color-mix(in srgb, var(--sl-color-red) 10%, transparent);
  }

  .diag__severity::before {
    content: '';
    width: 5px;
    height: 5px;
    border-radius: 999px;
    background-color: currentColor;
  }

  .warning .diag__severity {
    color: var(--sl-color-orange);
    background-color: color-mix(in srgb, var(--sl-color-orange) 10%, transparent);
  }

  .diag__code {
    display: inline-flex;
    align-items: center;
    min-width: 0;
    color: var(--sl-color-white);
    text-decoration: none;
  }

  .diag .diag__code code {
    padding: 0;
    border: 0;
    border-radius: 0;
    background: none;
    font-size: 14px;
    line-height: 22px;
    white-space: normal;
    overflow-wrap: anywhere;
  }

  .diag__code:hover code {
    color: var(--zn-primary);
  }

  .diag__code:focus-visible {
    outline: 2px solid var(--zn-primary);
    outline-offset: 2px;
    border-radius: 4px;
  }

  .diag__message {
    margin: 8px 0 0;
    font-size: 14px;
    line-height: 22px;
    color: var(--sl-color-gray-2);
    overflow-wrap: anywhere;
  }

  .diag__message code {
    white-space: normal;
    overflow-wrap: anywhere;
  }

  .diag__example {
    margin-top: 12px;
  }

  .diag__example :global(.expressive-code) {
    --ec-codeBg: var(--zn-surface-deep);
    --ec-frm-edBg: var(--zn-surface-deep);
    --ec-frm-trmBg: var(--zn-surface-deep);
  }

  .diag__help {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    margin: 12px 0 0;
    padding: 10px 12px;
    border-radius: 10px;
    background-color: color-mix(in srgb, var(--zn-primary) 9%, transparent);
    font-size: 13px;
    line-height: 21px;
    color: var(--sl-color-gray-1);
    overflow-wrap: anywhere;
  }

  .diag__help-icon {
    margin-top: 2px;
    color: var(--zn-primary);
  }

  .diag__help code {
    white-space: normal;
    overflow-wrap: anywhere;
    background-color: rgb(244 244 245 / 0.07);
    border: 0;
    color: var(--sl-color-white);
  }
</style>
