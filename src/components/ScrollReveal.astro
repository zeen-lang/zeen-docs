---
// Fades and lifts [data-reveal] blocks in as they come up from the bottom, and
// plays that back only when they slide off the bottom again (scrolling up), so
// nothing re-appears while the reader scrolls back. The hidden state lives behind
// the .zn-reveal class, so without this script (or with reduced motion)
// everything stays visible.
---

<script>
	const targets = document.querySelectorAll('[data-reveal]');

	if (targets.length > 0 && 'IntersectionObserver' in window) {
		// Mark what is already on screen first, so the first paint does not fade
		// the visible part out and straight back in.
		for (const target of targets) {
			if (target.getBoundingClientRect().top < window.innerHeight) {
				target.classList.add('is-revealed');
			}
		}

		document.documentElement.classList.add('zn-reveal');

		const observer = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					if (entry.isIntersecting) {
						entry.target.classList.add('is-revealed');
					} else if (entry.boundingClientRect.top > 0) {
						// Left through the bottom edge, so the reader is scrolling back up.
						entry.target.classList.remove('is-revealed');
					}
				}
			},
			{ rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
		);

		targets.forEach((target) => observer.observe(target));
	}
</script>
