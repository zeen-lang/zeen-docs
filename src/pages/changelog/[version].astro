---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { getCollection, render } from 'astro:content';
import Icon from '../../components/Icon.astro';

export async function getStaticPaths() {
  const releases = await getCollection(
    'changelog',
    ({ data }) => !data.draft,
  );

  return releases.map((release) => ({
    params: { version: release.id },
    props: { release },
  }));
}

const { release } = Astro.props;
const { Content } = await render(release);

const releases = await getCollection('changelog', ({ data }) => !data.draft);
const latest = releases.reduce((current, candidate) =>
  candidate.data.date > current.data.date ? candidate : current,
);
const isLatest = latest.id === release.id;
---

<StarlightPage
  frontmatter={{
    title: `v${release.data.version}`,
    ...(release.data.description && { description: release.data.description }),
    template: 'splash',
  }}
  hasSidebar={false}
>
  <article class="zn-changelog">
    <a class="zn-back" href="/changelog/">
      <Icon name="arrow_back" size={16} />
      All releases
    </a>

    <div class="zn-release-meta">
      <time datetime={release.data.date.toISOString()}>
        {release.data.date.toLocaleDateString('en-US', {
          year: 'numeric',
          month: 'long',
          day: 'numeric',
          timeZone: 'UTC',
        })}
      </time>

      {isLatest && <span class="zn-release-latest">Latest</span>}
    </div>

    {release.data.description && (
      <p class="zn-release-lead">{release.data.description}</p>
    )}

    <hr class="zn-rule" />

    <div class="zn-release-content">
      <Content />
    </div>
  </article>
</StarlightPage>

<style is:global>
  main:has(.zn-changelog) > .content-panel > .sl-container {
    max-width: 48rem;
  }

  main:has(.zn-changelog) > .content-panel:first-child h1 {
    margin: 0;
    font-size: clamp(34px, 4vw, 48px);
    line-height: 1.1;
    font-weight: 500;
    letter-spacing: -0.025em;
    color: var(--sl-color-white);
  }

  .zn-changelog {
    padding-top: 1.75rem;
    padding-bottom: 4rem;
  }

  .zn-back {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 32px;
    margin-left: -10px;
    padding: 0 10px;
    border-radius: 8px;
    font-size: 13px;
    line-height: 20px;
    font-weight: 500;
    color: var(--sl-color-gray-2);
    text-decoration: none;
    transition:
      background-color var(--zn-fast) var(--zn-ease),
      color var(--zn-fast) var(--zn-ease);
  }

  .zn-back:hover {
    background-color: rgb(244 244 245 / 0.06);
    color: var(--sl-color-gray-1);
  }

  .zn-back:focus-visible {
    outline: 2px solid var(--zn-primary);
    outline-offset: 2px;
  }

  .zn-release-meta {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 20px;
    font-size: 13px;
    line-height: 20px;
    color: var(--sl-color-gray-3);
  }

  .zn-release-latest {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 24px;
    padding: 0 10px;
    border-radius: 999px;
    background-color: var(--zn-primary-soft);
    font-size: 12px;
    line-height: 1;
    font-weight: 500;
    color: var(--zn-primary-high);
  }

  .zn-release-latest::before {
    content: '';
    width: 5px;
    height: 5px;
    border-radius: 999px;
    background-color: var(--zn-primary);
  }

  .zn-release-lead {
    margin: 12px 0 0;
    max-width: 62ch;
    font-size: 17px;
    line-height: 27px;
    color: var(--sl-color-gray-2);
  }

  .zn-rule {
    margin: 28px 0 0;
    border: 0;
    border-top: 1px solid var(--zn-hairline);
  }

  .zn-release-content {
    padding-top: 24px;
    color: var(--sl-color-gray-2);
    font-size: 15px;
    line-height: 26px;
  }

  .zn-release-content > :first-child {
    margin-top: 0;
  }

  .zn-release-content h2 {
    margin: 44px 0 12px;
    font-size: 24px;
    line-height: 32px;
    font-weight: 500;
    letter-spacing: -0.015em;
    color: var(--sl-color-white);
    scroll-margin-top: 6rem;
  }

  .zn-release-content h3 {
    margin: 28px 0 8px;
    font-size: 18px;
    line-height: 26px;
    font-weight: 500;
    color: var(--sl-color-gray-1);
    scroll-margin-top: 6rem;
  }

  .zn-release-content p,
  .zn-release-content li {
    font-size: 15px;
    line-height: 26px;
  }

  .zn-release-content ul,
  .zn-release-content ol {
    padding-left: 1.4em;
  }

  .zn-release-content li + li {
    margin-top: 4px;
  }

  .zn-release-content strong {
    font-weight: 500;
    color: var(--sl-color-gray-1);
  }

  .zn-release-content a {
    color: var(--sl-color-accent-high);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .zn-release-content a:hover {
    color: var(--zn-primary);
  }

  @media (max-width: 50rem) {
    .zn-changelog {
      padding-top: 1rem;
      padding-bottom: 2.5rem;
    }

    .zn-release-lead {
      font-size: 16px;
      line-height: 25px;
    }

    .zn-rule {
      margin-top: 24px;
    }

    .zn-release-content h2 {
      margin-top: 36px;
    }
  }
</style>
