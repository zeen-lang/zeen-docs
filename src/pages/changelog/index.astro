---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { getCollection } from 'astro:content';

const releases = (await getCollection(
  'changelog',
  ({ data }) => !data.draft,
)).sort((a, b) => {
  const byDate = b.data.date.getTime() - a.data.date.getTime();
  if (byDate !== 0) return byDate;

  const pa = a.data.version.split('.').map(Number);
  const pb = b.data.version.split('.').map(Number);
  for (let i = 0; i < 3; i++) {
    if (pa[i] !== pb[i]) return pb[i] - pa[i];
  }
  return 0;
});
---

<StarlightPage
  frontmatter={{
    title: 'Changelog',
    description: 'Release history of the Zeen programming language.',
    template: 'splash',
  }}
  hasSidebar={false}
>
  <div class="zn-changelog">
    <p class="zn-changelog__intro">Release history of the Zeen programming language.</p>

    <ol class="zn-releases">
      {releases.map((release, index) => (
        <li class="zn-releases__item">
          <a class="zn-release" href={`/changelog/${release.id}/`}>
            <div class="zn-release__head">
              <h2 class="zn-release__version">v{release.data.version}</h2>

              {index === 0 && <span class="zn-release__latest">Latest</span>}
            </div>

            {release.data.description && (
              <p class="zn-release__lead">{release.data.description}</p>
            )}
          </a>
        </li>
      ))}
    </ol>
  </div>
</StarlightPage>

<style is:global>
  main:has(.zn-changelog) > .content-panel > .sl-container {
    max-width: 56rem;
  }

  main:has(.zn-changelog) > .content-panel:first-child h1 {
    margin: 0;
    font-size: clamp(34px, 4vw, 48px);
    line-height: 1.1;
    font-weight: 500;
    letter-spacing: -0.025em;
    color: var(--sl-color-white);
  }

  .zn-changelog {
    padding-top: 1.75rem;
    padding-bottom: 4rem;
  }

  .zn-changelog__intro {
    margin: 0 0 32px;
    max-width: 46ch;
    font-size: 16px;
    line-height: 26px;
    color: var(--sl-color-gray-2);
  }

  .zn-releases {
    display: grid;
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .zn-releases__item {
    margin: 0;
  }

  .zn-release {
    display: block;
    margin: 0;
    padding: 18px 24px;
    border: 1px solid var(--zn-hairline);
    border-radius: 16px;
    background-color: var(--zn-surface);
    color: inherit;
    text-decoration: none;
    transition:
      border-color var(--zn-fast) var(--zn-ease),
      background-color var(--zn-fast) var(--zn-ease);
  }

  .zn-release:hover {
    border-color: var(--zn-hairline-strong);
    background-color: var(--zn-surface-raised);
  }

  .zn-release:focus-visible {
    outline: 2px solid var(--zn-primary);
    outline-offset: 2px;
  }

  .zn-release__head {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .zn-release__version {
    margin: 0;
    font-family: var(--zn-mono);
    font-size: 17px;
    line-height: 26px;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--sl-color-white);
  }

  .zn-release__latest {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 24px;
    padding: 0 10px;
    border-radius: 999px;
    background-color: var(--zn-primary-soft);
    font-size: 12px;
    line-height: 1;
    font-weight: 500;
    color: var(--zn-primary-high);
  }

  .zn-release__latest::before {
    content: '';
    width: 5px;
    height: 5px;
    border-radius: 999px;
    background-color: var(--zn-primary);
  }

  .zn-release__lead {
    margin: 8px 0 0;
    max-width: 68ch;
    font-size: 14px;
    line-height: 22px;
    color: var(--sl-color-gray-2);
  }

  @media (prefers-reduced-motion: reduce) {
    .zn-release {
      transition: none;
    }
  }

  @media (max-width: 50rem) {
    .zn-changelog {
      padding-top: 1rem;
      padding-bottom: 2.5rem;
    }

    .zn-changelog__intro {
      margin-bottom: 24px;
      font-size: 15px;
      line-height: 24px;
    }

    .zn-release {
      padding: 16px 18px;
    }

    .zn-release__version {
      font-size: 16px;
      line-height: 24px;
    }
  }
</style>
