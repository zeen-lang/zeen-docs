---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { getCollection } from 'astro:content';

const releases = (await getCollection(
  'changelog',
  ({ data }) => !data.draft,
)).sort((a, b) => {
  const byDate = b.data.date.getTime() - a.data.date.getTime();
  if (byDate !== 0) return byDate;

  const pa = a.data.version.split('.').map(Number);
  const pb = b.data.version.split('.').map(Number);
  for (let i = 0; i < 3; i++) {
    if (pa[i] !== pb[i]) return pb[i] - pa[i];
  }
  return 0;
});
---

<StarlightPage
  frontmatter={{
    title: 'Changelog',
    description: 'Release history of the Zeen programming language.',
    template: 'splash',
  }}
  hasSidebar={false}
>
  <div class="zn-changelog">
    <p class="zn-changelog__intro">Release history of the Zeen programming language.</p>

    <ol class="zn-releases">
      {releases.map((release, index) => (
        <li>
          <a class="zn-release" href={`/changelog/${release.id}/`}>
            <div class="zn-release__head">
              <h2 class="zn-release__version">
                <span class="zn-marker" aria-hidden="true">›</span>
                v{release.data.version}
              </h2>

              <time
                class="zn-release__date"
                datetime={release.data.date.toISOString()}
              >
                {release.data.date.toLocaleDateString('en-US', {
                  year: 'numeric',
                  month: 'short',
                  day: 'numeric',
                  timeZone: 'UTC',
                })}
              </time>

              {index === 0 && <span class="zn-release__latest">Latest</span>}
            </div>

            {release.data.description && (
              <p class="zn-release__lead">{release.data.description}</p>
            )}

            <span class="zn-release__cta">
              Release notes <span aria-hidden="true">→</span>
            </span>
          </a>
        </li>
      ))}
    </ol>
  </div>
</StarlightPage>

<style is:global>
  main:has(.zn-changelog) > .content-panel > .sl-container {
    max-width: 52rem;
  }

  main:has(.zn-changelog) > .content-panel:first-child h1 {
    margin: 0;
    font-size: clamp(34px, 4vw, 44px);
    line-height: 1.1;
    font-weight: 500;
    letter-spacing: -0.02em;
    color: var(--sl-color-white);
  }

  .zn-changelog {
    padding-top: 1.5rem;
    padding-bottom: 4rem;
  }

  .zn-changelog__intro {
    margin: 0 0 32px;
    font-size: 17px;
    line-height: 27px;
    color: var(--sl-color-gray-2);
  }

  .zn-releases {
    display: grid;
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .zn-release {
    display: block;
    padding: 20px 24px;
    border: 1px solid var(--zn-hairline);
    border-radius: 12px;
    background-color: var(--zn-surface);
    color: inherit;
    text-decoration: none;
    transition:
      border-color var(--zn-fast) var(--zn-ease),
      background-color var(--zn-fast) var(--zn-ease);
  }

  .zn-release:hover {
    border-color: var(--zn-hairline-strong);
    background-color: var(--zn-surface-raised);
  }

  .zn-release:focus-visible {
    outline: 2px solid var(--sl-color-accent-high);
    outline-offset: 2px;
  }

  .zn-release__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 8px 12px;
  }

  .zn-release__version {
    display: flex;
    align-items: baseline;
    gap: 6px;
    margin: 0;
    font-family: var(--zn-mono);
    font-size: 15px;
    line-height: 22px;
    font-weight: 500;
    letter-spacing: 0;
    color: var(--sl-color-gray-1);
  }

  .zn-marker {
    color: var(--sl-color-accent-high);
  }

  .zn-release__date {
    font-family: var(--zn-mono);
    font-size: 12px;
    line-height: 18px;
    color: var(--sl-color-gray-4);
  }

  .zn-release__latest {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 1px 8px;
    border: 1px solid rgb(147 219 182 / 0.24);
    border-radius: 999px;
    font-family: var(--zn-mono);
    font-size: 11px;
    line-height: 16px;
    color: var(--sl-color-accent-high);
  }

  .zn-release__latest::before {
    content: '';
    width: 5px;
    height: 5px;
    border-radius: 999px;
    background-color: var(--sl-color-accent-high);
  }

  .zn-release__lead {
    margin: 10px 0 0;
    max-width: 62ch;
    font-size: 14px;
    line-height: 22px;
    color: var(--sl-color-gray-2);
  }

  .zn-release__cta {
    display: inline-block;
    margin-top: 14px;
    font-family: var(--zn-mono);
    font-size: 12px;
    line-height: 18px;
    color: var(--sl-color-gray-3);
    transition: color var(--zn-fast) var(--zn-ease);
  }

  .zn-release:hover .zn-release__cta {
    color: var(--sl-color-gray-1);
  }

  @media (max-width: 50rem) {
    .zn-changelog {
      padding-top: 1rem;
      padding-bottom: 2rem;
    }

    .zn-release {
      padding: 18px 20px;
    }
  }
</style>
